:root{
  --paper:#faf8f4;
  --ink:#17130f;
  --muted:#6f6a63;
  --line:#e6e1d6;
  --accent:#2f56d9;
  --accent-dark:#17307a;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
button{font:inherit;color:inherit;background:none;border:0;-webkit-appearance:none;appearance:none}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

.page{max-width:640px;margin:0 auto;padding:64px 28px 96px}

.top-bar{margin-bottom:56px}
.top-bar h1{
  font-family:'Instrument Serif',serif;
  font-style:italic;
  font-weight:600;
  font-size:clamp(34px,6vw,52px);
  letter-spacing:-0.01em;
  margin:0 0 28px;
}

.tabs{
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:linear-gradient(180deg,#201f1d,#020202);
  border-radius:999px;
  padding:6px;
  box-shadow:0 10px 30px rgba(0,0,0,.18);
}
.tab-mark{
  width:32px;height:32px;border-radius:50%;
  display:grid;place-items:center;
  background:#0b0b0b;
  border:1px solid #333;
  color:#eee;
  font-family:'Instrument Serif',serif;
  font-style:italic;
  font-size:15px;
  margin-right:2px;
}
.tab{
  font-size:14.5px;font-weight:500;color:#f2f0ec;
  padding:10px 18px;border-radius:999px;cursor:pointer;
  transition:background .18s ease,color .18s ease;
  white-space:nowrap;
}
.tab:hover{background:#ffffff14}
.tab:active{background:#ffffff22}

.about h2{
  font-family:'Instrument Serif',serif;
  font-weight:500;
  font-size:clamp(26px,4vw,34px);
  margin:0 0 18px;
}
.about p{
  font-size:15.5px;line-height:1.7;color:var(--muted);
  max-width:52ch;margin:0 0 40px;
}

.showcase{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:56px}
.showcase-card{
  width:100%;text-align:left;cursor:pointer;
  border:1px solid var(--line);border-radius:20px;
  padding:18px;background:#fff;
  display:flex;flex-direction:column;gap:14px;
  transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
}
.showcase-card:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(20,15,5,.08);border-color:#d9d3c4}
.showcase-visual{
  background:#0d0d0d;border-radius:14px;overflow:hidden;
  aspect-ratio:16/11;display:flex;align-items:center;justify-content:center;
}
.showcase-card h3{margin:0 0 6px;font-size:16.5px;font-weight:600}
.showcase-card p{margin:0;font-size:13px;line-height:1.5;color:var(--muted)}
.card-arrow{font-size:13px;color:var(--accent);font-weight:600}

.mini-app-grid{width:100%;display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:16px}
.mini-app-grid span{aspect-ratio:1;border-radius:24%;background:linear-gradient(145deg,#3a3a3a,#101010)}
.mini-app-grid span.hi{background:linear-gradient(145deg,var(--accent),var(--accent-dark))}

.mini-search{width:100%;padding:16px 18px;display:flex;flex-direction:column;gap:12px}
.mini-search-row{display:flex;align-items:center;gap:10px}
.mini-favicon{width:20px;height:20px;border-radius:50%;background:linear-gradient(145deg,var(--accent),var(--accent-dark));flex:none}
.mini-lines{flex:1;display:flex;flex-direction:column;gap:5px}
.mini-line{height:6px;border-radius:3px;background:#3a3a3a}
.mini-line.title{background:#5b8dff;width:78%}
.mini-line.url{width:45%}

.mini-social{width:100%;height:100%;position:relative}
.mini-social-banner{position:absolute;inset:0;background:linear-gradient(135deg,var(--accent),var(--accent-dark))}
.mini-social-avatar{position:absolute;left:14px;bottom:12px;width:30px;height:30px;border-radius:50%;background:#0d0d0d;border:3px solid #0d0d0d;box-shadow:0 0 0 2px rgba(255,255,255,.28)}

.footer-links{display:flex;align-items:center;gap:10px}
.icon-link{
  width:38px;height:38px;border-radius:50%;
  border:1px solid var(--line);
  display:grid;place-items:center;
  transition:border-color .18s ease,background .18s ease;
}
.icon-link:hover{border-color:#c9c2ae;background:#fff}
.icon-link svg{width:18px;height:18px}

.tool-overlay{
  position:fixed;inset:0;display:none;align-items:center;justify-content:center;
  background:#090909;padding:20px;z-index:80;overflow:auto;
  font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  color:#f5f5f5;
}
.tool-overlay.open{display:flex}
.back-btn{
  position:fixed;top:22px;left:22px;z-index:90;
  display:flex;align-items:center;gap:8px;
  background:#181818;color:#eee;border:1px solid #2c2c2c;
  border-radius:999px;padding:9px 16px 9px 12px;
  font-size:13px;cursor:pointer;
}
.back-btn:hover{background:#212121}

#appOverlay .shell{width:min(100%,390px);min-height:780px;background:#000;border:1px solid #252525;border-radius:42px;overflow:hidden;box-shadow:0 24px 80px #000;position:relative}
#appOverlay .status{height:44px;padding:12px 22px 0;display:flex;justify-content:space-between;font-size:12px;font-weight:600}
#appOverlay .island{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:112px;height:30px;background:#000;border-radius:20px;z-index:3}
#appOverlay .screen{padding:14px 20px 30px}
#appOverlay .header{display:flex;align-items:center;justify-content:space-between;margin:8px 0 25px}
#appOverlay .header h1{font-size:26px;margin:0;letter-spacing:-.8px}
#appOverlay .gear{font-size:22px;background:#171717;border:0;color:#fff;border-radius:50%;width:40px;height:40px;cursor:pointer}
#appOverlay .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px 12px}
#appOverlay .app{text-align:center;cursor:pointer}
#appOverlay .icon{width:64px;height:64px;margin:auto;border-radius:15px;display:grid;place-items:center;background:linear-gradient(145deg,#333,#111);overflow:hidden;box-shadow:0 5px 14px #000;font-size:28px;font-weight:700}
#appOverlay .icon img{width:100%;height:100%;object-fit:cover}
#appOverlay .app span{display:block;font-size:12px;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#appOverlay .dock{position:absolute;left:14px;right:14px;bottom:14px;height:82px;border-radius:27px;background:#ffffff18;backdrop-filter:blur(22px);display:grid;grid-template-columns:repeat(4,1fr);align-items:center;padding:9px}
#appOverlay .dock .icon{width:58px;height:58px}
#appOverlay .settings{position:absolute;inset:0;background:#0b0b0b;z-index:5;transform:translateY(100%);transition:.28s ease;padding:55px 20px 25px}
#appOverlay .settings.open{transform:none}
#appOverlay .settings h2{font-size:28px;margin:0 0 24px}
#appOverlay .row{background:#171717;border-radius:18px;padding:16px;margin-bottom:12px}
#appOverlay .row label{font-size:12px;color:#aaa;display:block;margin-bottom:7px}
#appOverlay select,#appOverlay input[type=text],#appOverlay input[type=url]{width:100%;background:#0b0b0b;border:1px solid #303030;color:#fff;border-radius:11px;padding:11px;font-size:15px;outline:0}
#appOverlay select{appearance:none}
#appOverlay input[type=file]{width:100%;font-size:12px;color:#aaa}
#appOverlay .actions{display:flex;gap:10px;margin-top:18px}
#appOverlay button.action{flex:1;border:0;border-radius:13px;padding:12px;font-weight:700;cursor:pointer;background:#fff;color:#000}
#appOverlay button.secondary{background:#252525;color:#fff}
#appOverlay .preview{display:flex;align-items:center;gap:14px;padding:15px 0}
#appOverlay .preview .icon{margin:0;width:70px;height:70px}
#appOverlay .hint{font-size:12px;color:#777;line-height:1.5}
#appOverlay .close{position:absolute;right:18px;top:48px;background:#222;color:#fff;border:0;border-radius:50%;width:34px;height:34px;cursor:pointer}

#webOverlay .shell{width:min(100%,430px);height:min(820px,calc(100vh - 40px));min-height:0;background:#000;border:1px solid #292929;border-radius:38px;overflow:hidden;box-shadow:0 24px 80px #000;position:relative;display:flex;flex-direction:column}
#webOverlay .status{height:44px;padding:12px 21px 0;display:flex;justify-content:space-between;font-size:12px;font-weight:600}
#webOverlay .island{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:108px;height:29px;background:#000;border-radius:20px}
#webOverlay .top{padding:13px 18px 15px;border-bottom:1px solid #222}
#webOverlay .topline{display:flex;align-items:center;justify-content:space-between}
#webOverlay .title{font-size:23px;font-weight:700;letter-spacing:-.5px}
#webOverlay .gear{width:38px;height:38px;border:0;border-radius:50%;background:#191919;color:#fff;font-size:19px;cursor:pointer}
#webOverlay .search{margin-top:17px;height:48px;border:1px solid #303030;border-radius:24px;background:#151515;display:flex;align-items:center;padding:0 15px;gap:10px;color:#777}
#webOverlay .search input{flex:1;min-width:0;background:none;border:0;outline:0;color:#fff;font:inherit;font-size:14px}
#webOverlay .search input::placeholder{color:#777}
#webOverlay select{width:100%;background:#0b0b0b;border:1px solid #303030;color:#fff;border-radius:11px;padding:11px;font-size:15px;outline:0}
#webOverlay .search b{color:#ddd;font-size:15px;font-weight:500}
#webOverlay .results{padding:22px 19px 100px;overflow-y:auto;min-height:0;flex:1}
#webOverlay .query{font-size:13px;color:#888;margin-bottom:20px}
#webOverlay .result{padding:0 0 24px;margin-bottom:20px;border-bottom:1px solid #1d1d1d;cursor:pointer}
#webOverlay .result:last-child{margin-bottom:0}
#webOverlay .empty{padding:35px 0;color:#777;text-align:center;font-size:13px}
#webOverlay .source{display:flex;align-items:center;gap:10px;margin-bottom:8px}
#webOverlay .favicon{width:28px;height:28px;border-radius:50%;background:#202124;color:#fff;display:grid;place-items:center;overflow:hidden;font-size:12px;font-weight:700;flex:none}
#webOverlay .favicon img{width:100%;height:100%;object-fit:cover;border-radius:50%}
#webOverlay .site{font-size:13px;color:#aaa;line-height:1.2}
#webOverlay .site strong{display:block;color:#eee;font-size:14px;font-weight:500;margin-bottom:2px}
#webOverlay .result h2{font-size:18px;line-height:1.25;margin:5px 0 7px;color:#8ab4ff;font-weight:600}
#webOverlay .result p{font-size:13px;line-height:1.55;color:#aaa;margin:0}
#webOverlay .panel{position:absolute;z-index:5;inset:0;background:#0b0b0b;padding:53px 18px 24px;transform:translateY(100%);transition:transform .28s ease;overflow-y:auto;-webkit-overflow-scrolling:touch}
#webOverlay .panel.open{transform:none}
#webOverlay .close{position:absolute;right:17px;top:49px;width:34px;height:34px;border:0;border-radius:50%;background:#222;color:#fff;font-size:20px}
#webOverlay .panel h1{font-size:27px;margin:0 0 24px}
#webOverlay .card{background:#171717;border:1px solid #262626;border-radius:18px;padding:16px;margin-bottom:12px}
#webOverlay label{display:block;color:#999;font-size:11px;font-weight:700;letter-spacing:.6px;margin-bottom:8px}
#webOverlay input[type=text],#webOverlay input[type=url]{width:100%;background:#0b0b0b;color:#fff;border:1px solid #333;border-radius:11px;padding:12px;font-size:15px;outline:none}
#webOverlay input[type=file]{width:100%;color:#aaa;font-size:12px}
#webOverlay .preview{display:flex;align-items:center;gap:13px;margin-bottom:15px}
#webOverlay .preview .favicon{width:48px;height:48px;border-radius:50%;font-size:16px}
#webOverlay .preview strong{font-size:16px}
#webOverlay .muted{font-size:12px;color:#777;margin-top:4px}
#webOverlay .actions{display:flex;gap:10px;margin-top:16px}
#webOverlay .action{flex:1;padding:12px;border:0;border-radius:12px;background:#fff;color:#000;font-weight:700}
#webOverlay .secondary{background:#292929;color:#fff}
#webOverlay .hint{font-size:12px;color:#777;line-height:1.5;margin-top:14px}
#webOverlay .warn{color:#e2a33d}
#webOverlay .ok{color:#6fbf73}

#socialOverlay .shell{width:min(100%,430px);min-height:820px;background:#000;border:1px solid #292929;border-radius:38px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.8);position:relative;display:flex;flex-direction:column}
#socialOverlay .status{height:44px;padding:12px 21px 0;display:flex;justify-content:space-between;font-size:12px;font-weight:600;z-index:10}
#socialOverlay .island{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:108px;height:29px;background:#000;border-radius:20px;z-index:11}
#socialOverlay .top-nav{padding:12px 18px;border-bottom:1px solid #222;display:flex;align-items:center;justify-content:space-between}
#socialOverlay .platform-tabs{display:flex;background:#161616;padding:3px;border-radius:999px;border:1px solid #2c2c2c}
#socialOverlay .platform-tab{padding:6px 14px;border-radius:999px;font-size:13px;font-weight:600;color:#888;display:flex;align-items:center;gap:6px;transition:all .18s ease;cursor:pointer}
#socialOverlay .platform-tab.active{background:#282828;color:#fff}
#socialOverlay .platform-tab svg{width:14px;height:14px;fill:currentColor}
#socialOverlay .gear-btn{width:38px;height:38px;border-radius:50%;background:#191919;color:#fff;font-size:19px;display:grid;place-items:center;border:1px solid #2c2c2c;cursor:pointer}
#socialOverlay .gear-btn:hover{background:#252525}
#socialOverlay .preview-content{flex:1;overflow-y:auto;padding-bottom:40px;scrollbar-width:none}
#socialOverlay .preview-content::-webkit-scrollbar{display:none}
#socialOverlay .x-view{display:none}
#socialOverlay .x-view.active{display:block}
#socialOverlay .x-header{position:relative}
#socialOverlay .x-banner{height:120px;background:linear-gradient(135deg,#1e293b,#0f172a);position:relative;overflow:hidden}
#socialOverlay .x-banner-img{width:100%;height:100%;object-fit:cover}
#socialOverlay .x-avatar-wrapper{position:absolute;bottom:-40px;left:16px;border:4px solid #000;border-radius:50%;background:#111;width:82px;height:82px;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.5)}
#socialOverlay .x-avatar{width:100%;height:100%;object-fit:cover;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;background:#202020;color:#fff}
#socialOverlay .x-actions{display:flex;justify-content:flex-end;padding:12px 16px 0}
#socialOverlay .x-btn-follow{background:#fff;color:#000;font-weight:700;font-size:13.5px;padding:7px 18px;border-radius:999px}
#socialOverlay .x-profile-details{padding:12px 16px 16px}
#socialOverlay .x-name-row{display:flex;align-items:center;gap:4px}
#socialOverlay .x-name{font-size:18px;font-weight:800;color:#fff}
#socialOverlay .x-verified{color:#1d9bf0;width:18px;height:18px}
#socialOverlay .x-handle{font-size:14px;color:#71767b;margin-top:1px}
#socialOverlay .x-bio{font-size:14px;line-height:1.45;color:#e7e9ea;margin-top:10px}
#socialOverlay .x-meta{display:flex;gap:14px;font-size:13px;color:#71767b;margin-top:12px}
#socialOverlay .x-meta span strong{color:#fff}
#socialOverlay .x-feed-divider{border-bottom:1px solid #2f3336;margin-top:12px}
#socialOverlay .x-post{padding:14px 16px;border-bottom:1px solid #2f3336;display:flex;gap:12px}
#socialOverlay .x-post-avatar{width:40px;height:40px;border-radius:50%;background:#222;overflow:hidden;flex:none;display:grid;place-items:center;font-weight:700;font-size:16px}
#socialOverlay .x-post-content{flex:1}
#socialOverlay .x-post-header{display:flex;align-items:center;gap:4px;font-size:14px}
#socialOverlay .x-post-name{font-weight:700;color:#fff}
#socialOverlay .x-post-handle{color:#71767b}
#socialOverlay .x-post-text{font-size:14px;line-height:1.45;color:#e7e9ea;margin-top:4px}
#socialOverlay .linkedin-view{display:none;background:#f4f2ee;color:#000000e6;min-height:100%}
#socialOverlay .linkedin-view.active{display:block}
#socialOverlay .li-card{background:#fff;border-bottom:1px solid #e0e0e0;margin-bottom:8px}
#socialOverlay .li-banner{height:100px;background:linear-gradient(135deg,#0a66c2,#004182);position:relative}
#socialOverlay .li-avatar-wrapper{position:absolute;bottom:-30px;left:16px;border:4px solid #fff;border-radius:8px;background:#fff;width:72px;height:72px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.15)}
#socialOverlay .li-avatar{width:100%;height:100%;object-fit:cover;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;background:#eef3f8;color:#0a66c2}
#socialOverlay .li-details{padding:40px 16px 16px}
#socialOverlay .li-name{font-size:18px;font-weight:700;color:#000000e6}
#socialOverlay .li-tagline{font-size:13.5px;color:#000000e6;margin-top:3px;line-height:1.35}
#socialOverlay .li-sub{font-size:12px;color:#00000099;margin-top:6px}
#socialOverlay .li-btn-follow{background:#0a66c2;color:#fff;font-weight:600;font-size:14px;padding:6px 16px;border-radius:999px;margin-top:12px;display:inline-flex;align-items:center;gap:4px}
#socialOverlay .li-post{background:#fff;padding:12px 16px;border-top:1px solid #e0e0e0;border-bottom:1px solid #e0e0e0}
#socialOverlay .li-post-header{display:flex;gap:10px;align-items:center;margin-bottom:8px}
#socialOverlay .li-post-avatar{width:40px;height:40px;border-radius:4px;background:#eef3f8;overflow:hidden;display:grid;place-items:center;font-weight:700;color:#0a66c2}
#socialOverlay .li-post-info{display:flex;flex-direction:column}
#socialOverlay .li-post-title{font-size:13.5px;font-weight:700;color:#000000e6}
#socialOverlay .li-post-sub{font-size:11.5px;color:#00000099}
#socialOverlay .li-post-text{font-size:13px;line-height:1.4;color:#000000e6}
#socialOverlay .panel{position:absolute;z-index:30;inset:0;background:#0b0b0b;padding:53px 18px 24px;transform:translateY(100%);transition:transform .28s ease;overflow:auto}
#socialOverlay .panel.open{transform:translateY(0)}
#socialOverlay .panel h1{font-size:24px;margin:0 0 20px;letter-spacing:-.5px}
#socialOverlay .panel .close-btn{position:absolute;right:17px;top:49px;width:34px;height:34px;border:0;border-radius:50%;background:#222;color:#fff;font-size:20px;display:grid;place-items:center;cursor:pointer}
#socialOverlay .card{background:#171717;border:1px solid #262626;border-radius:18px;padding:16px;margin-bottom:12px}
#socialOverlay .card label{display:block;color:#999;font-size:11px;font-weight:700;letter-spacing:.6px;margin-bottom:8px}
#socialOverlay .card input[type=text],#socialOverlay .card input[type=url]{width:100%;background:#0b0b0b;color:#fff;border:1px solid #333;border-radius:11px;padding:11px;font-size:14px;outline:none}
#socialOverlay .card input[type=file]{width:100%;color:#aaa;font-size:12px}
#socialOverlay .card textarea{width:100%;background:#0b0b0b;color:#fff;border:1px solid #333;border-radius:11px;padding:10px;font-size:13.5px;outline:none;resize:none;height:60px}
#socialOverlay .preview-bar{display:flex;align-items:center;gap:13px;margin-bottom:15px;background:#141414;padding:12px;border-radius:14px}
#socialOverlay .preview-avatar{width:48px;height:48px;border-radius:50%;background:#222;overflow:hidden;display:grid;place-items:center;font-size:18px;font-weight:700}
#socialOverlay .actions{display:flex;gap:10px;margin-top:16px}
#socialOverlay .action-btn{flex:1;padding:12px;border:0;border-radius:12px;background:#fff;color:#000;font-weight:700;font-size:14px;cursor:pointer}
#socialOverlay .action-btn.secondary{background:#292929;color:#fff}
#socialOverlay .disclaimer-box{margin-top:20px;padding:12px 14px;border-radius:12px;background:#14120a;border:1px solid #3a3218;color:#d4af37;font-size:11.5px;line-height:1.5}
@media (max-width:480px){
  #socialOverlay .shell{border-radius:0;border:0;min-height:100vh}
}

@media (prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
}
@media (max-width:680px){
  .showcase{grid-template-columns:1fr 1fr}
}
@media (max-width:520px){
  .showcase{grid-template-columns:1fr}
  .page{padding:44px 20px 80px}
}
